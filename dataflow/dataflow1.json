{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_adls_targetfolder",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "ds_adls_targetfolder",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_adls_targetfolder",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "union1"
				},
				{
					"name": "window1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     file1 as string,",
				"     file2 as string",
				"}",
				"source(output(",
				"          Customer_Name as string,",
				"          {Total-orders-count} as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:[(concat('output/',$file1))]) ~> source1",
				"source(output(",
				"          Customer_Name as string,",
				"          {Total-orders-count} as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:[(concat('output/',$file2))]) ~> source2",
				"source1, source2 union(byName: true)~> union1",
				"source2 window(over(Customer_Name),",
				"     asc({Total-orders-count}, true),",
				"     count = count(Customer_Name)) ~> window1",
				"union1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          {1} as string,",
				"          {2} as string,",
				"          {Quest Q64 10 FT. x 10 FT. Slant Leg Instant U} as string,",
				"          Prop_3 as string,",
				"          {59.98} as string,",
				"          {http://images.acmesports.sports/Quest+Q64+10+FT.+x+10+FT.+Slant+Leg+Instant+Up+Canopy} as string",
				"     ),",
				"     partitionFileNames:['allfile.csv'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}