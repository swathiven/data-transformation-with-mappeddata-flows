{
	"name": "dataflow with derived column aggregation column split",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_adls_source_orderdata",
						"type": "DatasetReference"
					},
					"name": "Order"
				},
				{
					"dataset": {
						"referenceName": "ds_adls_source_orderdata",
						"type": "DatasetReference"
					},
					"name": "Customer"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_adls_targetfolder",
						"type": "DatasetReference"
					},
					"name": "sink1"
				},
				{
					"dataset": {
						"referenceName": "ds_adls_targetfolder",
						"type": "DatasetReference"
					},
					"name": "sink2"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "select1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "SplitBasedOrders"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     ordersFile as string,",
				"     customerFile as string",
				"}",
				"source(output(",
				"          OrderID as short,",
				"          CustomerID as short,",
				"          OrderDate as date,",
				"          Amount as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:[(concat('input/', $ordersFile))]) ~> Order",
				"source(output(",
				"          CustomerID as short,",
				"          Name as string,",
				"          City as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:[(concat('input/', $customerFile))]) ~> Customer",
				"Order, Customer join(Order@CustomerID == Customer@CustomerID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     partitionBy('hash', 1),",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          OrderID,",
				"          OrderDate,",
				"          Amount,",
				"          Customer_Name = Name,",
				"          City",
				"     ),",
				"     partitionBy('hash', 1),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"derivedColumn1 aggregate(groupBy(Customer_Name),",
				"     {Total-orders-count} = count(OrderID),",
				"     partitionBy('hash', 1)) ~> aggregate1",
				"aggregate1 split(equals(toString({Total-orders-count}), '1'),",
				"     ERROR_FUNCTION(''),",
				"     ERROR_FUNCTION(''),",
				"     equals(toString({Total-orders-count}), '2'),",
				"     disjoint: false) ~> SplitBasedOrders@(ordercount1, , , ordercount2)",
				"select1 derive(Customer_Name = upper(Customer_Name),",
				"          ordercategory = iif(Amount > 150, \"High\", \"Low\")) ~> derivedColumn1",
				"SplitBasedOrders@ordercount1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          {1} as string,",
				"          {2} as string,",
				"          {Quest Q64 10 FT. x 10 FT. Slant Leg Instant U} as string,",
				"          Prop_3 as string,",
				"          {59.98} as string,",
				"          {http://images.acmesports.sports/Quest+Q64+10+FT.+x+10+FT.+Slant+Leg+Instant+Up+Canopy} as string",
				"     ),",
				"     partitionFileNames:['order1.csv'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1",
				"SplitBasedOrders@ordercount2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          {1} as string,",
				"          {2} as string,",
				"          {Quest Q64 10 FT. x 10 FT. Slant Leg Instant U} as string,",
				"          Prop_3 as string,",
				"          {59.98} as string,",
				"          {http://images.acmesports.sports/Quest+Q64+10+FT.+x+10+FT.+Slant+Leg+Instant+Up+Canopy} as string",
				"     ),",
				"     partitionFileNames:['order2.csv'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink2"
			]
		}
	}
}